<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ClientPublishAgent.ViewModels"
             xmlns:r="using:ClientPublishAgent.Resources"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClientPublishAgent.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="个人工作平台" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="跨平台任务插件 · 原生主机限制 / Windows WSL Debian · MarketServer" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="24">
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" IsEnabled="{Binding !IsRunning}">
                    <TextBlock Text="发布系统" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="CPU 架构" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Architectures}" SelectedItem="{Binding SelectedArchitecture}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="发布类型" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding ReleaseTypes}" SelectedItem="{Binding SelectedReleaseType}" HorizontalAlignment="Stretch" />
                    <CheckBox IsChecked="{Binding PublishAot}" Content="使用 Native AOT 发布（默认开启）" />
                    <TextBlock Text="{Binding SelectionStatus}" TextWrapping="Wrap" />
                    <TextBlock Text="内置脚本目录（随应用发布，可在“脚本管理”页编辑）" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DesktopScriptsDirectory}" TextWrapping="Wrap" />
                    <TextBlock Text="当前打包输出目录" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding OutputDirectory}" TextWrapping="Wrap" />
                    <TextBlock Text="先按上方选项编译发布（默认 Native AOT），再按选择生成升级包、安装包或两者。源码目录由主窗口“打包目录配置”统一设置。" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SourceDirectory}" TextWrapping="Wrap" />
                    <TextBlock Text="当前版本" FontWeight="SemiBold" />
                    <TextBox Text="{Binding CurrentVersion}" PlaceholderText="例如 1.0.0" />
                    <TextBlock Text="目标版本" FontWeight="SemiBold" />
                    <TextBox Text="{Binding NextVersion}" PlaceholderText="例如 1.1.0" />
                    <TextBlock Text="升级地址（可选）" FontWeight="SemiBold" />
                    <TextBox Text="{Binding OssHost}" PlaceholderText="留空使用脚本默认值" />
                    <TextBlock Text="macOS Developer ID Application 签名身份（可选）" FontWeight="SemiBold" IsVisible="{Binding IsMacOSSelected}" />
                    <TextBox Text="{Binding SigningIdentity}" PlaceholderText="Developer ID Application: 团队名称 (TEAMID)" IsVisible="{Binding IsMacOSSelected}" />
                    <TextBlock Text="证书和私钥需已安装在当前 Mac 钥匙串中。可用 security find-identity -v -p codesigning 查询；留空将生成未签名包。签名不包含 Apple 公证。" TextWrapping="Wrap" IsVisible="{Binding IsMacOSSelected}" />
                    <TextBlock TextWrapping="Wrap" Text="发布目录取自脚本目录下的 publish-config.json。脚本会删除暂存目录、更新旧版本基线和差分输出；运行前请检查配置并备份。" />
                    <TextBlock TextWrapping="Wrap" Text="Windows 需要 NSIS；Linux 需要 pwsh / dpkg，Windows Linux wrapper 需要 WSL Debian + pwsh；macOS 需要原生 pwsh / hdiutil。MarketServer Linux AOT 仅原生 Linux。非沙箱，请只运行可信脚本。" />
                    <CheckBox IsChecked="{Binding IsConfirmed}" Content="已检查发布目录并备份" />
                    <Button Content="执行任务" Command="{Binding RunCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                <TextBlock Text="执行日志（仅保留最近内容）" FontWeight="SemiBold" />
                <TextBox Grid.Row="1" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="ScriptLogTextChanged" />
                <StackPanel Grid.Row="2" IsVisible="{Binding IsScriptInputAvailable}" Spacing="6">
                    <TextBlock Text="{x:Static r:ChatText.ScriptInputHint}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Text="{Binding ScriptInput}" PlaceholderText="{x:Static r:ChatText.ScriptInputPlaceholder}" />
                        <Button Grid.Column="1" Content="{x:Static r:ChatText.ScriptInputSend}" Command="{Binding SendScriptInputCommand}" />
                    </Grid>
                </StackPanel>
                <Button Grid.Row="3" Content="取消任务" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
            </Grid>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
